import React, { useState, useEffect, useCallback } from 'react';
import { Timer, RotateCcw, Trophy, Skull, Zap, ChevronUp, ChevronDown, CheckCircle2, Trash2, ShieldCheck, Target, AlertTriangle } from 'lucide-react';

const App = () => {
  const [timeLeft, setTimeLeft] = useState(120);
  const [isTimerRunning, setIsTimerRunning] = useState(false);
  const [matchPhase, setMatchPhase] = useState('AUTO'); // 'AUTO' or 'TELEOP'

  const initialScoreState = {
    // Items on Home Base (Multipliers Apply)
    yellowCubesBase: 0,
    greenCubesBase: 0,
    ringsBase: 0,
    plushiesUprightBase: 0,
    plushiesTippedBase: 0,
    ballsBase: 0, // Tennis ball on rocker base
    
    // Items in General Zone (Floor)
    yellowCubesZone: 0,
    greenCubesZone: 0,
    ringsZone: 0,
    plushiesUprightZone: 0,
    plushiesTippedZone: 0,
    ballsZone: 0,

    // Sabotage & Penalties
    scrapZone: 0,
    scrapBase: 0,
    hazardPenaltiesRecieved: 0, // -15 per instance
    
    // States
    hasPickleBall: false,
    activeStacks: [], // Array of heights [2, 3, 4]
    hasUltimateSummit: false,
    autoWinner: false,
    autoScouts: 0, // 0: None, 1: Neutral (10), 2: Invasive (25)
  };

  const [redAlliance, setRedAlliance] = useState({ ...initialScoreState });
  const [blueAlliance, setBlueAlliance] = useState({ ...initialScoreState });

  // Timer Logic
  useEffect(() => {
    let timer;
    if (isTimerRunning && timeLeft > 0) {
      timer = setInterval(() => {
        setTimeLeft((prev) => {
          if (prev === 91) setMatchPhase('TELEOP');
          return prev - 1;
        });
      }, 1000);
    } else if (timeLeft === 0) {
      setIsTimerRunning(false);
    }
    return () => clearInterval(timer);
  }, [isTimerRunning, timeLeft]);

  const formatTime = (seconds) => {
    const mins = Math.floor(seconds / 60);
    const secs = seconds % 60;
    return `${mins}:${secs < 10 ? '0' : ''}${secs}`;
  };

  const resetMatch = () => {
    setIsTimerRunning(false);
    setTimeLeft(120);
    setMatchPhase('AUTO');
    setRedAlliance({ ...initialScoreState });
    setBlueAlliance({ ...initialScoreState });
  };

  const calculateScore = useCallback((alliance, phase) => {
    let total = 0;

    // --- 1. Base Points (Floor/Zone) ---
    // Only counts in Teleop
    if (phase === 'TELEOP') {
      total += alliance.yellowCubesZone * 2;
      total += alliance.greenCubesZone * 2;
      total += alliance.ringsZone * 2;
      total += alliance.plushiesUprightZone * 10;
      total += alliance.plushiesTippedZone * 5;
      total += alliance.ballsZone * 5;
    }

    // --- 2. Base Points (Home Base) ---
    let baseOnTileValue = 0;
    baseOnTileValue += alliance.yellowCubesBase * 10;
    baseOnTileValue += alliance.greenCubesBase * 10;
    baseOnTileValue += alliance.ringsBase * 10;
    baseOnTileValue += alliance.plushiesUprightBase * 30;
    baseOnTileValue += alliance.plushiesTippedBase * 15;
    baseOnTileValue += alliance.ballsBase * 20;

    // --- 3. Multiplier Logic (Stacks) ---
    const totalItemsOnBase = 
      alliance.yellowCubesBase + alliance.greenCubesBase + alliance.ringsBase + 
      alliance.plushiesUprightBase + alliance.plushiesTippedBase + alliance.ballsBase;
    
    const avgItemValue = totalItemsOnBase > 0 ? baseOnTileValue / totalItemsOnBase : 0;

    let multiplierBonus = 0;
    alliance.activeStacks.forEach(height => {
      let m = 0;
      if (height === 2) m = 2; // (3x total - 1x base)
      else if (height === 3) m = 3; // (4x total - 1x base)
      else if (height >= 4) m = 4; // (5x total - 1x base)
      multiplierBonus += (avgItemValue * height) * m;
    });

    // Final Home Base Value (Items + Stacking Bonus)
    let homeBaseTotal = baseOnTileValue + multiplierBonus;

    // --- 4. Special Rule Bonuses ---
    if (alliance.hasUltimateSummit) total += 100;
    
    // VIP Retrieval (Pickle Ball on Home Base during Auto)
    // Note: User can toggle this via buttons, here we assume it's calculated at end of phase
    
    // --- 5. Auto Specific Logic ---
    if (phase === 'AUTO') {
      // Rule: Home Run - Any single cube/ring on Base = 2x Value
      // Rule: Auto-Stacker - Any valid 2+ stack = 2x Final Stack Value
      total += homeBaseTotal * 2;
      
      // Auto Scouts
      if (alliance.autoScouts === 1) total += 10;
      if (alliance.autoScouts === 2) total += 25;
    } else {
      // Teleop just adds the home base total normally
      total += homeBaseTotal;
    }

    // --- 6. Penalties & Final Modifiers ---
    // Scrap Penalties (Ignored if they have Pickle Ball)
    if (!alliance.hasPickleBall) {
      total -= (alliance.scrapZone * 2) + (alliance.scrapBase * 10);
    }
    
    // Hazard Penalties (Always applied)
    total -= (alliance.hazardPenaltiesRecieved * 15);

    // Auto Winner Bonus
    if (alliance.autoWinner) total += 50;

    return Math.round(Math.max(0, total));
  }, []);

  const updateVal = (setAlliance, field, delta) => {
    setAlliance(prev => ({ ...prev, [field]: Math.max(0, prev[field] + delta) }));
  };

  const addStack = (setAlliance, height) => {
    setAlliance(prev => ({ ...prev, activeStacks: [...prev.activeStacks, height] }));
  };

  const removeStack = (setAlliance, index) => {
    setAlliance(prev => ({
      ...prev, 
      activeStacks: prev.activeStacks.filter((_, i) => i !== index) 
    }));
  };

  const ScoreCounter = ({ label, value, onUp, onDown, small = false, color = "slate" }) => (
    <div className={`flex items-center justify-between ${small ? 'p-1' : 'p-2'} bg-white rounded-lg shadow-sm border border-slate-100`}>
      <span className={`${small ? 'text-[9px]' : 'text-[10px]'} font-bold text-${color}-600 uppercase truncate pr-1`}>{label}</span>
      <div className="flex items-center gap-2">
        <button onClick={onDown} className="p-0.5 hover:bg-slate-100 rounded-full transition-colors"><ChevronDown className="w-4 h-4 text-slate-400" /></button>
        <span className={`${small ? 'text-sm' : 'text-base'} font-black w-5 text-center`}>{value}</span>
        <button onClick={onUp} className="p-0.5 hover:bg-slate-100 rounded-full transition-colors"><ChevronUp className="w-4 h-4 text-slate-600" /></button>
      </div>
    </div>
  );

  const AlliancePanel = ({ alliance, setAlliance, teamColor, name }) => {
    const isRed = teamColor === 'red';
    const accentColor = isRed ? 'bg-red-500' : 'bg-blue-600';
    const borderColor = isRed ? 'border-red-200' : 'border-blue-200';

    return (
      <div className={`flex-1 flex flex-col rounded-2xl border-2 ${borderColor} ${isRed ? 'bg-red-50' : 'bg-blue-50'} overflow-hidden shadow-sm`}>
        {/* Alliance Header */}
        <div className={`${accentColor} p-3 text-white flex justify-between items-center`}>
          <div>
            <h2 className="text-lg font-black uppercase italic tracking-tighter leading-none">{name}</h2>
            <span className="text-[10px] font-bold opacity-80 uppercase">Total Score</span>
          </div>
          <div className="text-4xl font-black tabular-nums drop-shadow-sm">{calculateScore(alliance, matchPhase)}</div>
        </div>

        <div className="flex-1 overflow-y-auto p-2 space-y-3">
          {/* HOME BASE: Multipliers & Stacks */}
          <section className="bg-white/50 p-2 rounded-xl border border-white/80 shadow-inner">
            <h3 className="text-[9px] font-black text-slate-500 mb-1 tracking-widest uppercase flex items-center gap-1">
              <Target className="w-3 h-3 text-orange-500" /> Home Base (24"x24" Tile)
            </h3>
            <div className="grid grid-cols-2 gap-1.5">
              <ScoreCounter label="Y Cube (10)" value={alliance.yellowCubesBase} onUp={() => updateVal(setAlliance, 'yellowCubesBase', 1)} onDown={() => updateVal(setAlliance, 'yellowCubesBase', -1)} />
              <ScoreCounter label="G Cube (10)" value={alliance.greenCubesBase} onUp={() => updateVal(setAlliance, 'greenCubesBase', 1)} onDown={() => updateVal(setAlliance, 'greenCubesBase', -1)} />
              <ScoreCounter label="Ring (10)" value={alliance.ringsBase} onUp={() => updateVal(setAlliance, 'ringsBase', 1)} onDown={() => updateVal(setAlliance, 'ringsBase', -1)} />
              <ScoreCounter label="Ball+Base (20)" value={alliance.ballsBase} onUp={() => updateVal(setAlliance, 'ballsBase', 1)} onDown={() => updateVal(setAlliance, 'ballsBase', -1)} />
              <ScoreCounter label="Plush Up (30)" value={alliance.plushiesUprightBase} onUp={() => updateVal(setAlliance, 'plushiesUprightBase', 1)} onDown={() => updateVal(setAlliance, 'plushiesUprightBase', -1)} />
              <ScoreCounter label="Plush Tip (15)" value={alliance.plushiesTippedBase} onUp={() => updateVal(setAlliance, 'plushiesTippedBase', 1)} onDown={() => updateVal(setAlliance, 'plushiesTippedBase', -1)} />
            </div>

            {/* Stacking Multiplier Controls */}
            <div className="mt-2 bg-slate-900/5 p-2 rounded-lg border border-dashed border-slate-300">
              <span className="text-[8px] font-black text-slate-400 block mb-1 uppercase text-center">Active Multiplier Stacks</span>
              <div className="flex gap-1 mb-2">
                {[2, 3, 4].map(h => (
                  <button key={h} onClick={() => addStack(setAlliance, h)} className="flex-1 py-1 rounded-md text-[9px] font-black bg-white hover:bg-slate-50 border border-slate-200 shadow-sm">
                    + {h}-TIER
                  </button>
                ))}
              </div>
              <div className="flex flex-wrap gap-1 min-h-[24px]">
                {alliance.activeStacks.map((s, i) => (
                  <div key={i} className={`${accentColor} text-white px-2 py-0.5 rounded flex items-center gap-2 text-[9px] font-bold shadow-sm`}>
                    {s} Tiers <Trash2 className="w-3 h-3 cursor-pointer opacity-70 hover:opacity-100" onClick={() => removeStack(setAlliance, i)} />
                  </div>
                ))}
              </div>
            </div>
          </section>

          {/* TELEOP ZONE SCORING */}
          <section className={`p-1 transition-opacity ${matchPhase === 'AUTO' ? 'opacity-40 grayscale' : 'opacity-100'}`}>
            <h3 className="text-[9px] font-black text-slate-400 mb-1 tracking-widest uppercase flex items-center gap-1">
              <Zap className="w-3 h-3" /> Zone Floor (Standard)
            </h3>
            <div className="grid grid-cols-3 gap-1">
              <ScoreCounter small label="Cubes" value={alliance.yellowCubesZone + alliance.greenCubesZone} onUp={() => updateVal(setAlliance, 'yellowCubesZone', 1)} onDown={() => updateVal(setAlliance, 'yellowCubesZone', -1)} />
              <ScoreCounter small label="Ring" value={alliance.ringsZone} onUp={() => updateVal(setAlliance, 'ringsZone', 1)} onDown={() => updateVal(setAlliance, 'ringsZone', -1)} />
              <ScoreCounter small label="Ball" value={alliance.ballsZone} onUp={() => updateVal(setAlliance, 'ballsZone', 1)} onDown={() => updateVal(setAlliance, 'ballsZone', -1)} />
              <ScoreCounter small label="Upright" value={alliance.plushiesUprightZone} onUp={() => updateVal(setAlliance, 'plushiesUprightZone', 1)} onDown={() => updateVal(setAlliance, 'plushiesUprightZone', -1)} />
              <ScoreCounter small label="Tipped" value={alliance.plushiesTippedZone} onUp={() => updateVal(setAlliance, 'plushiesTippedZone', 1)} onDown={() => updateVal(setAlliance, 'plushiesTippedZone', -1)} />
              <ScoreCounter small label="Scrap" value={alliance.scrapZone} onUp={() => updateVal(setAlliance, 'scrapZone', 1)} onDown={() => updateVal(setAlliance, 'scrapZone', -1)} color="red" />
            </div>
          </section>

          {/* BONUSES & PENALTIES */}
          <section className="space-y-2 pt-1 border-t border-slate-200">
            <div className="grid grid-cols-2 gap-2">
              <button 
                onClick={() => setAlliance(p => ({ ...p, autoWinner: !p.autoWinner }))} 
                className={`p-2 rounded-lg text-[9px] font-black border flex items-center justify-center gap-1 transition-all ${alliance.autoWinner ? 'bg-amber-500 border-amber-600 text-white shadow-md' : 'bg-white text-slate-400 border-slate-200'}`}
              >
                <Trophy className="w-3 h-3" /> AUTO WINNER (+50)
              </button>
              <button 
                onClick={() => setAlliance(p => ({ ...p, hasPickleBall: !p.hasPickleBall }))} 
                className={`p-2 rounded-lg text-[9px] font-black border flex items-center justify-center gap-1 transition-all ${alliance.hasPickleBall ? 'bg-purple-600 border-purple-700 text-white shadow-md' : 'bg-white text-slate-400 border-slate-200'}`}
              >
                <ShieldCheck className="w-3 h-3" /> NEUTRALIZER (PICKLE)
              </button>
            </div>

            {/* Auto Scouting Selector */}
            <div className="flex bg-slate-200 p-1 rounded-lg gap-1">
              {[0, 1, 2].map(val => (
                <button 
                  key={val}
                  onClick={() => setAlliance(p => ({ ...p, autoScouts: val }))}
                  className={`flex-1 py-1 rounded text-[8px] font-black uppercase transition-all ${alliance.autoScouts === val ? 'bg-white text-slate-800 shadow-sm' : 'text-slate-500'}`}
                >
                  {val === 0 ? 'No Scout' : val === 1 ? 'Neutral (10)' : 'Invasive (25)'}
                </button>
              ))}
            </div>

            <div className="grid grid-cols-2 gap-2">
              <ScoreCounter small label="Hazard Recieved" value={alliance.hazardPenaltiesRecieved} onUp={() => updateVal(setAlliance, 'hazardPenaltiesRecieved', 1)} onDown={() => updateVal(setAlliance, 'hazardPenaltiesRecieved', -1)} color="red" />
              <button 
                onClick={() => setAlliance(p => ({ ...p, hasUltimateSummit: !p.hasUltimateSummit }))} 
                className={`p-2 rounded-lg text-[9px] font-black border-2 flex items-center justify-center gap-1 transition-all ${alliance.hasUltimateSummit ? 'bg-yellow-400 border-yellow-500 text-yellow-900 shadow-md' : 'bg-white text-slate-300 border-slate-200'}`}
              >
                ULTIMATE SUMMIT? (+100)
              </button>
            </div>
          </section>
        </div>
      </div>
    );
  };

  return (
    <div className="flex flex-col h-screen bg-slate-100 font-sans text-slate-900 overflow-hidden">
      {/* Universal Game Header */}
      <header className="bg-slate-900 p-3 shadow-2xl flex items-center justify-between px-6 z-30 border-b border-white/10">
        <div className="flex items-center gap-4">
          <div className="flex flex-col">
            <h1 className="text-white font-black italic text-lg leading-tight tracking-tighter">STACKER'S SUMMIT</h1>
            <span className="text-blue-400 text-[9px] font-bold tracking-[0.2em] uppercase">Student Game Engine</span>
          </div>
          <div className={`px-3 py-1 rounded-full text-[10px] font-black tracking-widest flex items-center gap-2 shadow-inner transition-colors duration-500 ${matchPhase === 'AUTO' ? 'bg-amber-500 text-amber-950 animate-pulse' : 'bg-blue-600 text-blue-50'}`}>
            <AlertTriangle className={`w-3 h-3 ${matchPhase === 'AUTO' ? 'block' : 'hidden'}`} />
            {matchPhase} PHASE
          </div>
        </div>

        <div className="flex items-center gap-6">
          <div className="flex flex-col items-center">
            <div className="text-white text-3xl font-mono font-black tabular-nums tracking-tighter drop-shadow-lg">
              {formatTime(timeLeft)}
            </div>
          </div>
          
          <div className="flex gap-2">
            <button 
              onClick={() => setIsTimerRunning(!isTimerRunning)}
              className={`p-2.5 rounded-full transition-all shadow-lg hover:scale-105 active:scale-95 ${isTimerRunning ? 'bg-red-500 hover:bg-red-600 text-white' : 'bg-green-500 hover:bg-green-600 text-white'}`}
            >
              {isTimerRunning ? <Skull className="w-5 h-5" /> : <Timer className="w-5 h-5" />}
            </button>
            <button 
              onClick={resetMatch}
              className="p-2.5 bg-slate-700 hover:bg-slate-600 text-white rounded-full transition-all shadow-lg active:rotate-180"
            >
              <RotateCcw className="w-5 h-5" />
            </button>
          </div>
        </div>
      </header>

      {/* Main Scoreboard Container */}
      <main className="flex-1 flex p-2 gap-2 overflow-hidden relative">
        <AlliancePanel 
          alliance={redAlliance} 
          setAlliance={setRedAlliance} 
          teamColor="red" 
          name="Red Alliance" 
        />
        
        <AlliancePanel 
          alliance={blueAlliance} 
          setAlliance={setBlueAlliance} 
          teamColor="blue" 
          name="Blue Alliance" 
        />

        {/* Floating Rule Quick-Ref (Optional UI Overlay) */}
        {timeLeft > 115 && (
          <div className="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-white/90 backdrop-blur-md p-6 rounded-3xl shadow-2xl border border-slate-200 text-center max-w-sm pointer-events-none animate-out fade-out duration-1000 delay-3000">
            <h3 className="text-xl font-black italic mb-2">AUTO PHASE ACTIVE</h3>
            <p className="text-sm text-slate-600">Home Base points are <strong>DOUBLED</strong>. Floor points are <strong>DISABLED</strong>.</p>
          </div>
        )}
      </main>

      {/* Footer Status */}
      <footer className="bg-white border-t border-slate-200 p-1.5 flex justify-center gap-6 text-[9px] font-black text-slate-400 uppercase tracking-widest z-10">
        <div className="flex items-center gap-1.5"><CheckCircle2 className="w-3 h-3 text-green-500" /> VEX IQ COMPATIBLE</div>
        <div className="flex items-center gap-1.5"><CheckCircle2 className="w-3 h-3 text-green-500" /> MULTIPLIER ENGINE V3.1</div>
        <div className="flex items-center gap-1.5 text-slate-500"><Target className="w-3 h-3" /> 24"x24" HOME BASE AREA</div>
      </footer>
    </div>
  );
};

export default App;
